<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jayant.lyrics.nowplaying</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jayant/Lyrics/mac-relay/update_nowplaying.sh</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>GITHUB_TOKEN</key>
        <string>YOUR_GITHUB_TOKEN</string>
        <key>NOW_PLAYING_GIST_ID</key>
        <string>YOUR_GIST_ID</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/lyrics_nowplaying.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/lyrics_nowplaying.err</string>
</dict>
</plist>
